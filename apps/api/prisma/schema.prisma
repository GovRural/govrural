// GovRural - Prisma schema
// FASE 01 (infraestrutura): datasource/generator + extensao PostGIS habilitada.
// FASE 02 (banco + multi-tenancy): Municipality, MunicipalitySettings, Department, AuditLog.
// FASE 03 (auth + RBAC): User, RefreshToken. AuditLog.userId agora possui FK.
// FASE 04 (produtores): Producer. RuralProperty/ProducerProperty entram na FASE 05.
// FASE 05 (propriedades): RuralProperty, ProducerProperty, PropertyArea.
// FASE 06 (solicitacoes): ServiceType, ServiceRequest, ServiceRequestHistory, ProtocolSequence.
// FASE 07 (ocorrencias): RuralOccurrence. Estradas/pontes (secao 28-29) ficam
// para uma fase pos-MVP (roadmap macro, secao 63).
// FASE 08 (maquinas): Machine, MachineService.
// FASE 09 (programas): Program, ProgramBeneficiary.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum MunicipalityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("municipality_status")
}

// Cada Municipality e um tenant. Nenhuma entidade de outro municipio pode
// ser acessada a partir de um municipality_id diferente (ver common/tenant).
model Municipality {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  state          String             @db.VarChar(2)
  ibgeCode       String?            @map("ibge_code")
  cnpj           String?
  phone          String?
  email          String?
  address        String?
  logoUrl        String?            @map("logo_url")
  primaryColor   String?            @map("primary_color")
  secondaryColor String?            @map("secondary_color")
  timezone       String             @default("America/Sao_Paulo")
  status         MunicipalityStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  settings          MunicipalitySettings?
  departments       Department[]
  users             User[]
  producers         Producer[]
  properties        RuralProperty[]
  serviceTypes      ServiceType[]
  serviceRequests   ServiceRequest[]
  protocolSequences ProtocolSequence[]
  occurrences       RuralOccurrence[]
  machines          Machine[]
  machineServices   MachineService[]
  programs          Program[]
  auditLogs         AuditLog[]

  @@map("municipalities")
}

// Configuracao de white-label por municipio (ver secao 7 e 74 da especificacao).
model MunicipalitySettings {
  id                   String       @id @default(uuid()) @db.Uuid
  municipalityId       String       @unique @map("municipality_id") @db.Uuid
  municipality         Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  departmentName       String?      @map("department_name")
  faviconUrl           String?      @map("favicon_url")
  whatsappNumber       String?      @map("whatsapp_number")
  institutionalMessage String?      @map("institutional_message") @db.Text
  customDomain         String?      @map("custom_domain")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@map("municipality_settings")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE

  @@map("department_status")
}

// Secretarias municipais (ver secao 10). Toda ocorrencia/solicitacao futura
// pode ser encaminhada para um Department diferente da Agricultura.
model Department {
  id             String           @id @default(uuid()) @db.Uuid
  municipalityId String           @map("municipality_id") @db.Uuid
  municipality   Municipality     @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name           String
  description    String?          @db.Text
  status         DepartmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  users           User[]
  serviceTypes    ServiceType[]
  serviceRequests ServiceRequest[]
  occurrences     RuralOccurrence[]

  @@unique([municipalityId, name])
  @@map("departments")
}

enum UserRole {
  SUPER_ADMIN
  MUNICIPAL_ADMIN
  SECRETARY
  TECHNICIAN
  MACHINE_OPERATOR
  PRODUCER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

// Ver secao 8 (perfis de usuario). SUPER_ADMIN nao pertence a nenhum
// municipio (municipalityId nulo); todos os demais perfis pertencem a
// exatamente um municipio (isolamento de tenant). producerId so e usado por
// usuarios com role PRODUCER (portal do produtor, secao 32) - mais de um
// User pode apontar para o mesmo Producer (ex: pai e filho no mesmo
// cadastro).
model User {
  id             String        @id @default(uuid()) @db.Uuid
  municipalityId String?       @map("municipality_id") @db.Uuid
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  departmentId   String?       @map("department_id") @db.Uuid
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  producerId     String?       @map("producer_id") @db.Uuid
  producer       Producer?     @relation(fields: [producerId], references: [id], onDelete: SetNull)
  name           String
  email          String        @unique
  passwordHash   String        @map("password_hash")
  role           UserRole
  phone          String?
  status         UserStatus    @default(ACTIVE)
  lastLoginAt    DateTime?     @map("last_login_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  assignedServiceRequests ServiceRequest[]
  serviceRequestHistory   ServiceRequestHistory[]
  reportedOccurrences     RuralOccurrence[]
  operatedMachineServices MachineService[]        @relation("MachineServiceOperator")

  @@index([municipalityId])
  @@map("users")
}

// Refresh tokens sao persistidos (hash, nunca o token em claro) para permitir
// logout/revogacao real - um JWT sozinho nao pode ser invalidado antes de
// expirar.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT

  @@map("audit_action")
}

// Ver secao 43. Nunca apagado por usuarios comuns.
model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  municipalityId String?       @map("municipality_id") @db.Uuid
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  userId         String?       @map("user_id") @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         AuditAction
  entity         String
  entityId       String?       @map("entity_id") @db.Uuid
  oldData        Json?         @map("old_data")
  newData        Json?         @map("new_data")
  ip             String?
  userAgent      String?       @map("user_agent")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([municipalityId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum ProducerType {
  INDIVIDUAL
  COMPANY
  ASSOCIATION
  COOPERATIVE
  OTHER

  @@map("producer_type")
}

enum ProducerStatus {
  ACTIVE
  INACTIVE

  @@map("producer_status")
}

// Cadastro do produtor rural (ver secao 11). Propriedades (RuralProperty)
// e o vinculo produtor<->propriedade (ProducerProperty) entram na Fase 05.
model Producer {
  id                String         @id @default(uuid()) @db.Uuid
  municipalityId    String         @map("municipality_id") @db.Uuid
  municipality      Municipality   @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name              String
  cpfCnpj           String         @map("cpf_cnpj")
  producerType      ProducerType   @map("producer_type")
  birthDate         DateTime?      @map("birth_date")
  phone             String?
  whatsapp          String?
  email             String?
  address           String?        @db.Text
  ruralRegistration String?        @map("rural_registration")
  stateRegistration String?        @map("state_registration")
  carNumber         String?        @map("car_number")
  cafNumber         String?        @map("caf_number")
  association       String?
  cooperative       String?
  status            ProducerStatus @default(ACTIVE)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  propertyLinks   ProducerProperty[]
  serviceRequests ServiceRequest[]
  machineServices MachineService[]
  programBenefits ProgramBeneficiary[]
  users           User[]

  @@unique([municipalityId, cpfCnpj])
  @@index([municipalityId])
  @@map("producers")
}

enum PropertyOwnershipType {
  OWNED
  LEASED
  LOAN
  PARTNERSHIP
  POSSESSION
  OTHER

  @@map("property_ownership_type")
}

enum PropertyStatus {
  ACTIVE
  INACTIVE

  @@map("property_status")
}

// Propriedade rural (ver secao 12). O vinculo com produtor(es) e feito via
// ProducerProperty (secao 13) - nunca uma FK rigida producer_id aqui, pois
// uma propriedade pode ter mais de um produtor/responsavel. O poligono
// completo da propriedade (geometry) fica para a Fase GIS dedicada; por ora
// so guardamos um ponto de referencia (latitude/longitude).
model RuralProperty {
  id                 String                @id @default(uuid()) @db.Uuid
  municipalityId     String                @map("municipality_id") @db.Uuid
  municipality       Municipality          @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name               String
  registrationNumber String?               @map("registration_number")
  ruralAddress       String?               @map("rural_address") @db.Text
  locality           String?
  totalArea          Decimal               @map("total_area") @db.Decimal(12, 4)
  latitude           Float?
  longitude          Float?
  carNumber          String?               @map("car_number")
  stateRegistration  String?               @map("state_registration")
  propertyType       String?               @map("property_type")
  ownershipType      PropertyOwnershipType @map("ownership_type")
  status             PropertyStatus        @default(ACTIVE)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  deletedAt          DateTime?             @map("deleted_at")

  producerLinks   ProducerProperty[]
  areas           PropertyArea[]
  serviceRequests ServiceRequest[]
  machineServices MachineService[]
  programBenefits ProgramBeneficiary[]

  @@index([municipalityId])
  @@map("rural_properties")
}

// Vinculo produtor <-> propriedade (ver secao 13). Mantido como historico:
// start_date/end_date permitem que o mesmo par producer+property tenha mais
// de um vinculo ao longo do tempo, entao NAO ha unique(producerId, propertyId).
model ProducerProperty {
  id               String        @id @default(uuid()) @db.Uuid
  producerId       String        @map("producer_id") @db.Uuid
  producer         Producer      @relation(fields: [producerId], references: [id], onDelete: Cascade)
  propertyId       String        @map("property_id") @db.Uuid
  property         RuralProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  relationshipType String?       @map("relationship_type")
  percentage       Float?
  isPrimary        Boolean       @default(false) @map("is_primary")
  startDate        DateTime?     @map("start_date")
  endDate          DateTime?     @map("end_date")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([producerId])
  @@index([propertyId])
  @@map("producer_properties")
}

enum PropertyAreaStatus {
  ACTIVE
  INACTIVE

  @@map("property_area_status")
}

// Talhoes/areas dentro de uma propriedade (ver secao 14). Sem municipality_id
// proprio - o isolamento de tenant e feito pela propriedade-pai.
model PropertyArea {
  id           String             @id @default(uuid()) @db.Uuid
  propertyId   String             @map("property_id") @db.Uuid
  property     RuralProperty      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  areaHectares Decimal            @map("area_hectares") @db.Decimal(12, 4)
  activity     String?
  crop         String?
  soilType     String?            @map("soil_type")
  irrigation   Boolean            @default(false)
  status       PropertyAreaStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  @@index([propertyId])
  @@map("property_areas")
}

enum ServiceTypeStatus {
  ACTIVE
  INACTIVE

  @@map("service_type_status")
}

// Tipos de servico configuraveis por municipio (ver secao 74). Exemplos:
// trator, patrolamento, cascalhamento, calcario, sementes, vacinacao.
model ServiceType {
  id             String            @id @default(uuid()) @db.Uuid
  municipalityId String            @map("municipality_id") @db.Uuid
  municipality   Municipality      @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  departmentId   String?           @map("department_id") @db.Uuid
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name           String
  description    String?           @db.Text
  status         ServiceTypeStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  serviceRequests ServiceRequest[]

  @@unique([municipalityId, name])
  @@index([municipalityId])
  @@map("service_types")
}

// Contador atomico do protocolo (GR-{ano}-{sequencial}) por municipio e ano.
// O incremento e feito com upsert dentro de uma transacao (ver
// ServiceRequestsService.nextProtocol) - o UPDATE trava a linha e serializa
// concorrencia no Postgres, entao nao ha necessidade de lock explicito.
model ProtocolSequence {
  municipalityId String       @map("municipality_id") @db.Uuid
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  year           Int
  lastNumber     Int          @default(0) @map("last_number")

  @@id([municipalityId, year])
  @@map("protocol_sequences")
}

enum ServiceRequestStatus {
  RECEIVED
  UNDER_ANALYSIS
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  WAITING_DOCUMENT

  @@map("service_request_status")
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("service_request_priority")
}

// Solicitacao de servico do produtor (ver secao 17-19). O protocolo e unico
// globalmente mas sequencial por municipio+ano (ver ProtocolSequence).
// Cancelamento/rejeicao usam o campo status - nunca ha DELETE, o historico
// (ServiceRequestHistory) e permanente.
model ServiceRequest {
  id             String                 @id @default(uuid()) @db.Uuid
  municipalityId String                 @map("municipality_id") @db.Uuid
  municipality   Municipality           @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  protocol       String                 @unique
  producerId     String                 @map("producer_id") @db.Uuid
  producer       Producer               @relation(fields: [producerId], references: [id], onDelete: Restrict)
  propertyId     String?                @map("property_id") @db.Uuid
  property       RuralProperty?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  departmentId   String                 @map("department_id") @db.Uuid
  department     Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  serviceTypeId  String                 @map("service_type_id") @db.Uuid
  serviceType    ServiceType            @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  description    String                 @db.Text
  priority       ServiceRequestPriority @default(MEDIUM)
  status         ServiceRequestStatus   @default(RECEIVED)
  requestedAt    DateTime               @default(now()) @map("requested_at")
  analyzedAt     DateTime?              @map("analyzed_at")
  approvedAt     DateTime?              @map("approved_at")
  scheduledAt    DateTime?              @map("scheduled_at")
  completedAt    DateTime?              @map("completed_at")
  assignedUserId String?                @map("assigned_user_id") @db.Uuid
  assignedUser   User?                  @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  latitude       Float?
  longitude      Float?
  estimatedCost  Decimal?               @map("estimated_cost") @db.Decimal(12, 2)
  actualCost     Decimal?               @map("actual_cost") @db.Decimal(12, 2)
  notes          String?                @db.Text
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  history         ServiceRequestHistory[]
  machineServices MachineService[]

  @@index([municipalityId])
  @@index([producerId])
  @@index([status])
  @@map("service_requests")
}

// Historico de status (ver secao 20). Nunca apagar. Anexos (attachments)
// ficam para quando o modulo de Documentos (secao 38) for implementado.
model ServiceRequestHistory {
  id               String                @id @default(uuid()) @db.Uuid
  serviceRequestId String                @map("service_request_id") @db.Uuid
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  userId           String?               @map("user_id") @db.Uuid
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  previousStatus   ServiceRequestStatus? @map("previous_status")
  newStatus        ServiceRequestStatus  @map("new_status")
  comment          String?               @db.Text
  latitude         Float?
  longitude        Float?
  createdAt        DateTime              @default(now()) @map("created_at")

  @@index([serviceRequestId])
  @@map("service_request_history")
}

enum OccurrenceType {
  ROAD
  BRIDGE
  FIRE
  WATER
  ENERGY
  ILLEGAL_DUMPING
  ANIMALS
  MACHINERY
  AGRICULTURE
  HEALTH
  SECURITY
  ENVIRONMENT
  OTHER

  @@map("occurrence_type")
}

enum OccurrencePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("occurrence_priority")
}

enum OccurrenceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("occurrence_status")
}

// Ocorrencia rural generica (ver secao 26-27). Encaminhamento (department_id)
// pode ser definido na criacao ou depois, via update. Fotos/anexos ficam para
// o modulo de Documentos (secao 38).
model RuralOccurrence {
  id             String             @id @default(uuid()) @db.Uuid
  municipalityId String             @map("municipality_id") @db.Uuid
  municipality   Municipality       @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  reporterUserId String?            @map("reporter_user_id") @db.Uuid
  reporterUser   User?              @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)
  departmentId   String?            @map("department_id") @db.Uuid
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  type           OccurrenceType
  title          String
  description    String             @db.Text
  priority       OccurrencePriority @default(MEDIUM)
  status         OccurrenceStatus   @default(OPEN)
  latitude       Float?
  longitude      Float?
  resolvedAt     DateTime?          @map("resolved_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([municipalityId])
  @@index([status])
  @@map("rural_occurrences")
}

enum MachineStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE

  @@map("machine_status")
}

// Patrulha mecanizada (ver secao 21). "type" e "fuelType" sao texto livre -
// a especificacao apenas exemplifica valores (trator, patrol, caminhao...),
// sem enum fechado.
model Machine {
  id               String        @id @default(uuid()) @db.Uuid
  municipalityId   String        @map("municipality_id") @db.Uuid
  municipality     Municipality  @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name             String
  type             String
  brand            String?
  model            String?
  year             Int?
  plate            String?
  serialNumber     String?       @map("serial_number")
  hourlyCost       Decimal       @map("hourly_cost") @db.Decimal(12, 2)
  fuelType         String?       @map("fuel_type")
  status           MachineStatus @default(ACTIVE)
  currentHourMeter Decimal       @default(0) @map("current_hour_meter") @db.Decimal(12, 2)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  services MachineService[]

  @@index([municipalityId])
  @@map("machines")
}

enum MachineServiceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("machine_service_status")
}

// Servico executado por uma maquina (ver secao 22). Custo calculado
// automaticamente (secao 23: custo_hora x horas) quando o servico e
// finalizado - ver MachineServicesService. Evidencias fotograficas ficam
// para o modulo de Documentos (secao 38).
model MachineService {
  id               String               @id @default(uuid()) @db.Uuid
  municipalityId   String               @map("municipality_id") @db.Uuid
  municipality     Municipality         @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  machineId        String               @map("machine_id") @db.Uuid
  machine          Machine              @relation(fields: [machineId], references: [id], onDelete: Restrict)
  operatorId       String?              @map("operator_id") @db.Uuid
  operator         User?                @relation("MachineServiceOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  producerId       String               @map("producer_id") @db.Uuid
  producer         Producer             @relation(fields: [producerId], references: [id], onDelete: Restrict)
  propertyId       String?              @map("property_id") @db.Uuid
  property         RuralProperty?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceRequestId String?              @map("service_request_id") @db.Uuid
  serviceRequest   ServiceRequest?      @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  serviceType      String               @map("service_type")
  status           MachineServiceStatus @default(SCHEDULED)
  scheduledDate    DateTime?            @map("scheduled_date")
  startTime        DateTime?            @map("start_time")
  endTime          DateTime?            @map("end_time")
  initialHourMeter Decimal?             @map("initial_hour_meter") @db.Decimal(12, 2)
  finalHourMeter   Decimal?             @map("final_hour_meter") @db.Decimal(12, 2)
  totalHours       Decimal?             @map("total_hours") @db.Decimal(12, 2)
  fuelConsumption  Decimal?             @map("fuel_consumption") @db.Decimal(12, 2)
  estimatedCost    Decimal?             @map("estimated_cost") @db.Decimal(12, 2)
  actualCost       Decimal?             @map("actual_cost") @db.Decimal(12, 2)
  latitude         Float?
  longitude        Float?
  notes            String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([municipalityId])
  @@index([machineId])
  @@index([status])
  @@map("machine_services")
}

enum ProgramStatus {
  ACTIVE
  INACTIVE

  @@map("program_status")
}

// Programa municipal (ver secao 24). Exemplos: Programa de Calcario,
// Sementes, Mudas, Agricultura Familiar. "eligibilityRules" e texto livre -
// a especificacao nao define um formato estruturado para regras.
model Program {
  id               String        @id @default(uuid()) @db.Uuid
  municipalityId   String        @map("municipality_id") @db.Uuid
  municipality     Municipality  @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name             String
  description      String?       @db.Text
  startDate        DateTime?     @map("start_date")
  endDate          DateTime?     @map("end_date")
  budget           Decimal?      @db.Decimal(14, 2)
  eligibilityRules String?       @map("eligibility_rules") @db.Text
  status           ProgramStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  beneficiaries ProgramBeneficiary[]

  @@unique([municipalityId, name])
  @@index([municipalityId])
  @@map("programs")
}

enum ProgramBeneficiaryStatus {
  PENDING
  APPROVED
  DELIVERED
  REJECTED
  CANCELLED

  @@map("program_beneficiary_status")
}

// Beneficiario de um programa (ver secao 25). Sem municipality_id proprio -
// o isolamento de tenant e feito pelo Program-pai.
model ProgramBeneficiary {
  id           String                   @id @default(uuid()) @db.Uuid
  programId    String                   @map("program_id") @db.Uuid
  program      Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  producerId   String                   @map("producer_id") @db.Uuid
  producer     Producer                 @relation(fields: [producerId], references: [id], onDelete: Restrict)
  propertyId   String?                  @map("property_id") @db.Uuid
  property     RuralProperty?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  benefitType  String                   @map("benefit_type")
  quantity     Decimal?                 @db.Decimal(12, 4)
  unit         String?
  value        Decimal?                 @db.Decimal(12, 2)
  status       ProgramBeneficiaryStatus @default(PENDING)
  approvalDate DateTime?                @map("approval_date")
  deliveryDate DateTime?                @map("delivery_date")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@index([programId])
  @@index([producerId])
  @@map("program_beneficiaries")
}
