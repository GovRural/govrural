# -----------------------------------------------------------------------------
# GovRural - Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------------

# --- Database (Postgres + PostGIS) ---
POSTGRES_USER=govrural
POSTGRES_PASSWORD=govrural
POSTGRES_DB=govrural
POSTGRES_PORT=5432
DATABASE_URL="postgresql://govrural:govrural@localhost:5432/govrural?schema=public"

# --- Redis / BullMQ ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001
API_URL="http://localhost:3001"
NODE_ENV=development

# --- Auth ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Seed (cria o primeiro Super Admin, se nenhum existir) ---
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_PORT=3000

# --- Storage (S3 / Supabase Storage) ---
STORAGE_PROVIDER="s3"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# --- WhatsApp (future integration) ---
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
